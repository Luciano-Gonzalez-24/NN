CFLAGS=-O3 -fopenmp -lm

CC=gcc

RM=rm -f

EXEC=neural_network_test
EST = estructuras
TRAIN = entrenamiento
ACT = activation

all: $(EXEC)

$(EXEC): main_test.o $(EST).o $(TRAIN).o $(ACT).o
	$(CC) $(CFLAGS) main_test.o $(EST).o $(TRAIN).o $(ACT).o -o $(EXEC)

main_test.o: main_test.c $(EST).h $(TRAIN).h $(ACT).h
	$(CC) $(CFLAGS) -c main_test.c

$(EST).o: $(EST).c $(EST).h
	$(CC) $(CFLAGS) -c $(EST).c

$(TRAIN).o: $(TRAIN).c $(EST).h $(TRAIN).h $(ACT).h
	$(CC) $(CFLAGS) -c $(TRAIN).c


run:
	./$(EXEC)

clean:
	$(RM) main_test.o $(EST).o $(TRAIN).o $(ACT).o $(EXEC)
